# Every variable here is required. The server refuses to start without them —
# there are no defaults to silently fall back to.

# --- backend (cmd/server) ---
# Owner role: runs migrations, creates the org, grants the app role.
DATABASE_ADMIN_URL=postgres://owner:pass@localhost:5432/getnotified?sslmode=disable
# App role: a member of getnotified_app, subject to row-level security.
DATABASE_URL=postgres://app:pass@localhost:5432/getnotified?sslmode=disable
PORT=8080
API_KEY=
ORG_SLUG=default
ORG_NAME=Your Company

# --- frontend (web/.env) ---
# API_URL=http://localhost:8080
# API_KEY=              must match the backend
# AUTH_SECRET=          random string; rotating it signs everyone out
# AUTH_PASSWORD_HASH=   node web/scripts/hash-password.js 'your password'
# SITE_ORIGIN=          absolute origin, used for canonical and Open Graph URLs

# --- channel credentials (backend, only what you use) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

IMESSAGE_RELAY_URL=
IMESSAGE_RELAY_KEY=
